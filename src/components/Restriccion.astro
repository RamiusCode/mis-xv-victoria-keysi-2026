---
// src/components/Restriccion.astro
// Aviso discreto de "sin niños" para los XV, sobre el mismo cielo de
// estrellas del Calendario (/imagenes/fondocalendario.webp), con
// estrellitas subiendo y destellos. Un ícono dorado fino, el título en
// Great Vibes y la frase en Cormorant Garamond. Va antes del Regalo.
// ── DATOS EDITABLES ───────────────────────────────────────────
const titulo = "Solo adultos";
const frase =
    "Con mucho cariño, les pedimos que esta noche tan especial sea solo para adultos.";
const gracias = "¡Gracias por su comprensión!";
// ──────────────────────────────────────────────────────────────

// Estrellitas y destellos: calculados acá para que servidor y navegador
// dibujen exactamente lo mismo.
const estrellas = Array.from({ length: 22 }, (_, i) => ({
    izq: (i * 41 + 5) % 100,
    tam: 2 + (i % 4) * 1.1,
    dur: 8 + ((i * 5) % 7),
    retraso: (i * 1.1) % 12,
    deriva: ((i * 13) % 30) - 15,
    oro: i % 3 === 1,
}));

const destellos = Array.from({ length: 6 }, (_, i) => ({
    izq: 8 + ((i * 47) % 84),
    arriba: 10 + ((i * 31) % 80),
    tam: 8 + (i % 3) * 4,
    dur: 2.6 + (i % 4) * 0.7,
    retraso: (i * 0.8) % 4,
}));
---

<section id="restriccion" class="seccion">
    <div class="estrellas" aria-hidden="true">
        {
            estrellas.map((e) => (
                <span
                    class:list={["estrella", { oro: e.oro }]}
                    style={`left:${e.izq}%; width:${e.tam}px; height:${e.tam}px; --deriva:${e.deriva}px; animation-duration:${e.dur}s; animation-delay:-${e.retraso}s;`}
                />
            ))
        }
        {
            destellos.map((d) => (
                <span
                    class="destello"
                    style={`left:${d.izq}%; top:${d.arriba}%; width:${d.tam}px; height:${d.tam}px; animation-duration:${d.dur}s; animation-delay:-${d.retraso}s;`}
                />
            ))
        }
    </div>

    <div class="contenido" id="rs-contenido">
        <!-- Ícono: niña y niño dentro de un círculo cruzado, en dorado fino -->
        <svg class="icono" viewBox="0 0 100 100" aria-hidden="true">
            <defs>
                <linearGradient id="rs-oro" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#fff0c2"></stop>
                    <stop offset="0.5" stop-color="#e0b55e"></stop>
                    <stop offset="1" stop-color="#a8762f"></stop>
                </linearGradient>
            </defs>
            <circle
                cx="50"
                cy="50"
                r="44"
                fill="none"
                stroke="url(#rs-oro)"
                stroke-width="3.2"></circle>
            <g fill="url(#rs-oro)">
                <!-- niña -->
                <circle cx="37" cy="33" r="6.5"></circle>
                <path d="M37 41 L27 64 H47 Z"></path>
                <rect x="32.5" y="63" width="3.4" height="12" rx="1.7"></rect>
                <rect x="38.2" y="63" width="3.4" height="12" rx="1.7"></rect>
                <!-- niño -->
                <circle cx="63" cy="33" r="6.5"></circle>
                <rect x="56" y="41" width="14" height="20" rx="4"></rect>
                <rect x="57.5" y="59" width="4.2" height="16" rx="2"></rect>
                <rect x="64.3" y="59" width="4.2" height="16" rx="2"></rect>
            </g>
            <line
                x1="19"
                y1="81"
                x2="81"
                y2="19"
                stroke="url(#rs-oro)"
                stroke-width="3.2"
                stroke-linecap="round"></line>
        </svg>

        <h2 class="titulo">{titulo}</h2>
        <span class="adorno" aria-hidden="true"><i></i></span>
        <p class="frase">{frase}</p>
        <p class="gracias">{gracias}</p>
    </div>
</section>

<style>
    /*
       Mismo cielo que el Calendario. El fondo va como degradado y no como
       color: el modo oscuro forzado oscurece colores pero respeta las
       imágenes. Arriba y abajo se funde con negro para empalmar con el
       marco de Vestimenta y el del Regalo.
    */
    .seccion {
        position: relative;
        width: 100%;
        overflow: hidden;
        container-type: inline-size;
        background-image:
            linear-gradient(
                180deg,
                #0b0310 0%,
                rgba(11, 3, 16, 0) 18%,
                rgba(11, 3, 16, 0) 82%,
                #0b0310 100%
            ),
            url("/imagenes/fondocalendario.webp");
        background-size: 100% 100%, cover;
        background-repeat: no-repeat;
        background-position: center, center;
        background-color: #12051f;
        text-align: center;
    }

    .contenido {
        position: relative;
        z-index: 1;
        padding: 14cqw 12% 16cqw;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    /* ── Estrellitas que suben + destellos ──────────────────── */
    .estrellas {
        position: absolute;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
        container-type: size;
    }

    .estrella {
        position: absolute;
        bottom: -2%;
        border-radius: 50%;
        background-image: radial-gradient(
            circle,
            #ffffff 0%,
            rgba(220, 170, 255, 0.9) 40%,
            rgba(190, 110, 255, 0) 72%
        );
        box-shadow: 0 0 6px rgba(210, 150, 255, 0.85);
        opacity: 0;
        animation: flotar linear infinite;
    }

    .estrella.oro {
        background-image: radial-gradient(
            circle,
            #ffffff 0%,
            rgba(255, 225, 160, 0.9) 40%,
            rgba(255, 200, 110, 0) 72%
        );
        box-shadow: 0 0 6px rgba(255, 215, 140, 0.85);
    }

    @keyframes flotar {
        0% {
            transform: translate(0, 0) scale(0.6);
            opacity: 0;
        }
        10% {
            opacity: 0.95;
        }
        50% {
            transform: translate(var(--deriva), -50cqh) scale(1);
        }
        85% {
            opacity: 0.6;
        }
        100% {
            transform: translate(calc(var(--deriva) * -0.5), -100cqh)
                scale(0.8);
            opacity: 0;
        }
    }

    .destello {
        position: absolute;
        transform: translate(-50%, -50%) scale(0);
        animation: titilar ease-in-out infinite;
    }

    .destello::before,
    .destello::after {
        content: "";
        position: absolute;
        left: 50%;
        top: 50%;
        border-radius: 50%;
        transform: translate(-50%, -50%);
        background-image: radial-gradient(
            ellipse,
            #fff 0%,
            rgba(255, 222, 150, 0.9) 35%,
            rgba(255, 222, 150, 0) 70%
        );
    }

    .destello::before {
        width: 100%;
        height: 18%;
    }

    .destello::after {
        width: 18%;
        height: 100%;
    }

    @keyframes titilar {
        0%,
        100% {
            transform: translate(-50%, -50%) scale(0);
            opacity: 0;
        }
        50% {
            transform: translate(-50%, -50%) scale(1.5);
            opacity: 1;
        }
    }

    /* ── Contenido ──────────────────────────────────────────── */
    .icono {
        width: 22cqw;
        height: auto;
        filter: drop-shadow(0 0 10px rgba(255, 210, 130, 0.45))
            drop-shadow(0 3px 6px rgba(0, 0, 0, 0.5));
    }

    /* Great Vibes, sin mayúsculas forzadas ni espaciado entre letras */
    .titulo {
        margin: 4cqw 0 0;
        font-family: "Great Vibes", cursive;
        font-weight: 400;
        font-size: 15cqw;
        line-height: 1.1;
        background-image: linear-gradient(
            180deg,
            #fff3cf 0%,
            #f1cb7a 50%,
            #b98a3e 100%
        );
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.6))
            drop-shadow(0 0 14px rgba(210, 120, 255, 0.5));
    }

    /* Filete dorado con un rombito al medio */
    .adorno {
        position: relative;
        display: block;
        width: 46%;
        height: 1px;
        margin: 3cqw auto 5cqw;
        background-image: linear-gradient(
            90deg,
            rgba(225, 181, 94, 0),
            rgba(225, 181, 94, 0.95),
            rgba(225, 181, 94, 0)
        );
    }

    .adorno i {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 1.8cqw;
        height: 1.8cqw;
        transform: translate(-50%, -50%) rotate(45deg);
        background-image: linear-gradient(135deg, #f3d58f, #b98a3e);
    }

    .frase {
        margin: 0;
        font-family: "Cormorant Garamond", serif;
        font-weight: 600;
        font-size: 5.6cqw;
        line-height: 1.35;
        color: #ffffff;
        text-shadow:
            0 1px 4px rgba(0, 0, 0, 0.7),
            0 0 10px rgba(150, 60, 210, 0.5);
    }

    .gracias {
        margin: 4.5cqw 0 0;
        font-family: "Cormorant Garamond", serif;
        font-style: italic;
        font-weight: 600;
        font-size: 5cqw;
        color: #f1cb7a;
        text-shadow: 0 1px 4px rgba(0, 0, 0, 0.7);
    }

    @media (prefers-reduced-motion: reduce) {
        .estrella {
            display: none;
        }
        .destello {
            animation: none;
            transform: translate(-50%, -50%) scale(1);
            opacity: 0.7;
        }
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const contenido = document.getElementById("rs-contenido");
        if (
            !contenido ||
            window.matchMedia("(prefers-reduced-motion: reduce)").matches
        )
            return;

        // Ícono, título, filete, frase y gracias, uno tras otro
        gsap.fromTo(
            Array.from(contenido.children),
            { opacity: 0, y: 16 },
            {
                opacity: 1,
                y: 0,
                duration: 0.9,
                stagger: 0.18,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: contenido,
                    start: "top 80%",
                    toggleActions: "play none none reset",
                },
            },
        );
    });
</script>
