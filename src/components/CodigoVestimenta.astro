---
// src/components/CodigoVestimenta.astro
// Código de vestimenta de los XV, como el diseño: el marco dorado
// (/imagenes/marcovestimenta.webp) a sangre, el óvalo con la gema
// (/imagenes/ovalado.webp) con una corona encima y "DRESS CODE" adentro,
// "Elegante" debajo y la pareja dorada (/imagenes/vestimenta.webp) abajo,
// con estrellitas subiendo y destellos.
//
// El marco se muestra entero con su proporción (9:16) y todo lo demás se
// ubica en % encima, así queda igual en cualquier celular.
// ── DATOS EDITABLES ───────────────────────────────────────────
const titulo1 = "Dress";
const titulo2 = "Code";
const estilo = "Vestimenta formal";
const reserva = "Queda reservado los colores";
// Los colores reservados: se muestran con una muestrita redonda
const coloresReservados = [
    { nombre: "morado", muestra: "#6a1fa8" },
    { nombre: "lila", muestra: "#c8a2e8" },
];
// ──────────────────────────────────────────────────────────────

// Estrellitas y destellos: calculados acá para que servidor y navegador
// dibujen exactamente lo mismo.
const estrellas = Array.from({ length: 22 }, (_, i) => ({
    izq: 10 + ((i * 41) % 80),
    tam: 2 + (i % 4) * 1.1,
    dur: 9 + ((i * 5) % 8),
    retraso: (i * 1.1) % 14,
    deriva: ((i * 13) % 30) - 15,
}));

const destellos = Array.from({ length: 6 }, (_, i) => ({
    izq: 14 + ((i * 47) % 72),
    arriba: 8 + ((i * 31) % 80),
    tam: 8 + (i % 3) * 4,
    dur: 2.6 + (i % 4) * 0.7,
    retraso: (i * 0.8) % 4,
}));
---

<section id="codigo-vestimenta" class="seccion">
    <img
        src="/imagenes/marcovestimenta.webp"
        alt=""
        aria-hidden="true"
        width="900"
        height="1599"
        class="fondo"
        loading="lazy"
    />

    <div class="estrellas" aria-hidden="true">
        {
            estrellas.map((e) => (
                <span
                    class="estrella"
                    style={`left:${e.izq}%; width:${e.tam}px; height:${e.tam}px; --deriva:${e.deriva}px; animation-duration:${e.dur}s; animation-delay:-${e.retraso}s;`}
                />
            ))
        }
        {
            destellos.map((d) => (
                <span
                    class="destello"
                    style={`left:${d.izq}%; top:${d.arriba}%; width:${d.tam}px; height:${d.tam}px; animation-duration:${d.dur}s; animation-delay:-${d.retraso}s;`}
                />
            ))
        }
    </div>

    <div class="capa" id="cv-capa">
        <!-- Corona dorada sobre el óvalo -->
        <svg class="corona" viewBox="0 0 120 70" aria-hidden="true">
            <defs>
                <linearGradient id="cv-oro" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#fff0c2"></stop>
                    <stop offset="0.5" stop-color="#e0b55e"></stop>
                    <stop offset="1" stop-color="#9c6d2b"></stop>
                </linearGradient>
            </defs>
            <path
                fill="url(#cv-oro)"
                d="M14 58 L8 20 L34 40 L60 8 L86 40 L112 20 L106 58 Z"
            ></path>
            <rect x="12" y="58" width="96" height="9" rx="3" fill="url(#cv-oro)"
            ></rect>
            <circle cx="8" cy="18" r="5" fill="url(#cv-oro)"></circle>
            <circle cx="60" cy="7" r="6" fill="url(#cv-oro)"></circle>
            <circle cx="112" cy="18" r="5" fill="url(#cv-oro)"></circle>
            <circle cx="60" cy="44" r="6" fill="#8a2fd0"></circle>
            <circle cx="34" cy="49" r="3.6" fill="#8a2fd0"></circle>
            <circle cx="86" cy="49" r="3.6" fill="#8a2fd0"></circle>
        </svg>

        <!-- Óvalo con "DRESS CODE" adentro -->
        <div class="ovalo">
            <img
                src="/imagenes/ovalado.webp"
                alt=""
                aria-hidden="true"
                width="900"
                height="1200"
                class="ovalo-img"
                loading="lazy"
            />
            <div class="ovalo-texto">
                <h2 class="titulo">
                    <span>{titulo1}</span>
                    <span>{titulo2}</span>
                </h2>
                <span class="adorno" aria-hidden="true"><i></i></span>
            </div>
        </div>

        <p class="estilo">{estilo}</p>

        <!-- Los colores reservados, resaltados con su muestra y un trazo -->
        <div class="reserva">
            <p class="reserva-texto">{reserva}</p>
            <div class="colores">
                {
                    coloresReservados.map((c, i) => (
                        <>
                            {i > 0 && <span class="barra">/</span>}
                            <span class="color">
                                <i
                                    class="muestra"
                                    style={`background-image:linear-gradient(${c.muestra},${c.muestra})`}
                                />
                                {c.nombre}
                            </span>
                        </>
                    ))
                }
            </div>
        </div>

        <img
            src="/imagenes/vestimenta.webp"
            alt="Pareja vestida de gala"
            width="900"
            height="600"
            class="pareja"
            loading="lazy"
        />
    </div>
</section>

<style>
    /*
       container-type deja medir todo contra el ancho de la sección. El
       fondo va como degradado y no como color: el modo oscuro forzado
       oscurece colores pero respeta las imágenes.
    */
    .seccion {
        position: relative;
        width: 100%;
        overflow: hidden;
        container-type: inline-size;
        background-image: linear-gradient(#0b0310, #0b0310);
    }

    .fondo {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 900 / 1599;
        user-select: none;
        -webkit-user-drag: none;
    }

    /* ── Estrellitas que suben + destellos ──────────────────── */
    .estrellas {
        position: absolute;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
        container-type: size;
    }

    .estrella {
        position: absolute;
        bottom: 4%;
        border-radius: 50%;
        background-image: radial-gradient(
            circle,
            #ffffff 0%,
            rgba(255, 225, 160, 0.9) 40%,
            rgba(255, 200, 110, 0) 72%
        );
        box-shadow: 0 0 6px rgba(255, 215, 140, 0.85);
        opacity: 0;
        animation: flotar linear infinite;
    }

    @keyframes flotar {
        0% {
            transform: translate(0, 0) scale(0.6);
            opacity: 0;
        }
        10% {
            opacity: 0.95;
        }
        50% {
            transform: translate(var(--deriva), -45cqh) scale(1);
        }
        85% {
            opacity: 0.6;
        }
        100% {
            transform: translate(calc(var(--deriva) * -0.5), -90cqh)
                scale(0.8);
            opacity: 0;
        }
    }

    .destello {
        position: absolute;
        transform: translate(-50%, -50%) scale(0);
        animation: titilar ease-in-out infinite;
    }

    .destello::before,
    .destello::after {
        content: "";
        position: absolute;
        left: 50%;
        top: 50%;
        border-radius: 50%;
        transform: translate(-50%, -50%);
        background-image: radial-gradient(
            ellipse,
            #fff 0%,
            rgba(255, 222, 150, 0.9) 35%,
            rgba(255, 222, 150, 0) 70%
        );
    }

    .destello::before {
        width: 100%;
        height: 18%;
    }

    .destello::after {
        width: 18%;
        height: 100%;
    }

    @keyframes titilar {
        0%,
        100% {
            transform: translate(-50%, -50%) scale(0);
            opacity: 0;
        }
        50% {
            transform: translate(-50%, -50%) scale(1.5);
            opacity: 1;
        }
    }

    /* ── Capa con el contenido, encima del marco ────────────── */
    .capa {
        position: absolute;
        inset: 0;
        z-index: 1;
    }

    .corona {
        position: absolute;
        left: 0;
        right: 0;
        margin: 0 auto;
        top: 5.2%;
        width: 19%;
        height: auto;
        filter: drop-shadow(0 3px 6px rgba(0, 0, 0, 0.55))
            drop-shadow(0 0 10px rgba(255, 210, 130, 0.35));
    }

    /* El óvalo: 60% del ancho, centrado */
    .ovalo {
        position: absolute;
        left: 0;
        right: 0;
        margin: 0 auto;
        top: 9.5%;
        width: 60%;
    }

    .ovalo-img {
        display: block;
        width: 100%;
        height: auto;
        filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.55));
    }

    .ovalo-texto {
        position: absolute;
        left: 0;
        right: 0;
        top: 30%;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .titulo {
        margin: 0;
        font-family: "Cormorant Garamond", serif;
        font-weight: 600;
        font-size: 8.5cqw;
        line-height: 1.02;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        background-image: linear-gradient(
            180deg,
            #fff3cf 0%,
            #f1cb7a 50%,
            #b98a3e 100%
        );
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.6));
    }

    .titulo span {
        display: block;
    }

    /* Filete dorado con un rombito al medio, bajo "DRESS CODE" */
    .adorno {
        position: relative;
        display: block;
        width: 46%;
        height: 1px;
        margin-top: 4cqw;
        background-image: linear-gradient(
            90deg,
            rgba(225, 181, 94, 0),
            rgba(225, 181, 94, 0.95),
            rgba(225, 181, 94, 0)
        );
    }

    .adorno i {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 1.8cqw;
        height: 1.8cqw;
        transform: translate(-50%, -50%) rotate(45deg);
        background-image: linear-gradient(135deg, #f3d58f, #b98a3e);
    }

    .estilo {
        position: absolute;
        left: 0;
        right: 0;
        top: 57.5%;
        margin: 0;
        text-align: center;
        font-family: "Cormorant Garamond", serif;
        font-weight: 700;
        font-size: 8.5cqw;
        line-height: 1;
        color: #ffffff;
        text-shadow:
            0 0 8px rgba(255, 255, 255, 0.4),
            0 0 18px rgba(200, 120, 255, 0.7),
            0 2px 6px rgba(0, 0, 0, 0.6);
    }

    /* ── Colores reservados ──────────────────────────────────── */
    .reserva {
        position: absolute;
        left: 0;
        right: 0;
        top: 63.5%;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .reserva-texto {
        margin: 0;
        font-family: "Cormorant Garamond", serif;
        font-style: italic;
        font-weight: 600;
        font-size: 5.2cqw;
        line-height: 1.2;
        color: #f3e6ff;
        text-shadow: 0 1px 4px rgba(0, 0, 0, 0.7);
    }

    /*
       Los dos colores van dentro de una cápsula con trazo dorado, cada
       uno con su muestrita redonda: así se entiende de un vistazo qué
       colores no usar.
    */
    .colores {
        display: inline-flex;
        align-items: center;
        gap: 2.4cqw;
        margin-top: 2cqw;
        padding: 1.4cqw 5cqw;
        border: 1.5px solid #e2bb6c;
        border-radius: 999px;
        box-shadow:
            0 0 0 3px rgba(226, 187, 108, 0.18),
            0 0 14px rgba(190, 90, 255, 0.4);
        font-family: "Cormorant Garamond", serif;
        font-weight: 700;
        font-size: 6cqw;
        line-height: 1;
        color: #ffffff;
        text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
    }

    .color {
        display: inline-flex;
        align-items: center;
        gap: 1.6cqw;
    }

    .muestra {
        display: inline-block;
        width: 4.4cqw;
        height: 4.4cqw;
        border-radius: 50%;
        border: 1.5px solid #f0cf86;
        box-shadow: 0 0 8px rgba(200, 120, 255, 0.7);
    }

    .barra {
        color: #e2bb6c;
        font-weight: 600;
    }

    /* La pareja dorada, abajo, sobre el polvo dorado del marco */
    .pareja {
        position: absolute;
        left: 0;
        right: 0;
        margin: 0 auto;
        bottom: 3%;
        width: 54%;
        height: auto;
        filter: drop-shadow(0 0 12px rgba(255, 200, 110, 0.35));
    }

    @media (prefers-reduced-motion: reduce) {
        .estrella {
            display: none;
        }
        .destello {
            animation: none;
            transform: translate(-50%, -50%) scale(1);
            opacity: 0.7;
        }
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const capa = document.getElementById("cv-capa");
        if (
            !capa ||
            window.matchMedia("(prefers-reduced-motion: reduce)").matches
        )
            return;

        // Corona, óvalo, el estilo, los colores y la pareja, uno tras otro
        gsap.fromTo(
            Array.from(capa.children),
            { opacity: 0, y: 20 },
            {
                opacity: 1,
                y: 0,
                duration: 1,
                stagger: 0.2,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: capa,
                    start: "top 75%",
                    toggleActions: "play none none reset",
                },
            },
        );
    });
</script>
