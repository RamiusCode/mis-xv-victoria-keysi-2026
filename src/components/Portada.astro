---
// src/components/Portada.astro - Portada de XV estilo fantasía: un marco
// dorado con fondo violeta que se estira al alto de cada celular, el
// nombre arriba, el sobre lacrado al centro y "Toca el Sobre" abajo.
// Detrás del sobre: un aura violeta, rayos de luz girando lento, destellos
// que titilan y chispas que suben.
// El sobre entero es el botón. Al tocarlo tiembla, el lacre se enciende,
// estalla una lluvia de chispas y la portada se va en un resplandor.
// La melodía arranca en ese toque (ver abrirTodo, en el script): es el
// único momento en que el navegador deja sonar un audio, porque hace falta
// un gesto de la persona. Desde ahí la maneja BotonMusica.astro.
//
// Imágenes (comprimidas en webp; los png originales quedan de respaldo):
//   /imagenes/fondoportada.webp  fondo de la escena (castillo)
//   /imagenes/nombre.webp      nombre de la quinceañera
//   /imagenes/sobre.webp       sobre con el lacre del 15
// ── DATOS EDITABLES ───────────────────────────────────────────
const llamada = "Toca el Sobre";
// Texto alternativo del nombre (lo leen los lectores de pantalla)
const nombreAlt = "Mis XV años";
// ──────────────────────────────────────────────────────────────

/*
   Destellos y chispas. Los valores se calculan acá y no en el script
   para que el servidor y el navegador dibujen exactamente lo mismo.
*/
const destellos = Array.from({ length: 16 }, (_, i) => ({
    izq: 10 + ((i * 53) % 80),
    arriba: 12 + ((i * 37) % 74),
    tam: 7 + ((i * 5) % 4) * 3.5,
    dur: 2.4 + ((i * 7) % 5) * 0.6,
    retraso: (i * 0.9) % 4.5,
    oro: i % 3 !== 0,
}));

const chispas = Array.from({ length: 22 }, (_, i) => ({
    izq: 8 + ((i * 41) % 84),
    dur: 7 + ((i * 3) % 7),
    retraso: (i * 1.1) % 9,
    tam: 2 + (i % 3) * 1.2,
    deriva: ((i * 17) % 40) - 20,
    oro: i % 2 === 0,
}));
---

<!-- CAPA BLANCA DE TRANSICIÓN — tapa el fondo del layout durante el fade -->
<div
    id="capa-blanca"
    style="
    position: fixed;
    inset: 0;
    background-image: linear-gradient(#ffffff, #ffffff);
    z-index: 8499;
    opacity: 1;
    pointer-events: none;
"
>
</div>

<!--
   La portada va por debajo del botón flotante de música (z 9000) para que
   el control siga accesible mientras la portada se desvanece.
-->
<section
    class="fixed inset-0 w-full flex justify-center z-[8500]"
    id="portada-section"
>
    <!-- Columna de celular: en tablet / PC no se estira de costado -->
    <div class="marco" id="marco-portada">
        <!-- Aura violeta detrás del sobre -->
        <div class="aura" id="aura" aria-hidden="true"></div>

        <!--
           Marco dorado de fantasía: doble filete, filigranas en las cuatro
           esquinas (la misma pieza espejada), un adorno con gema arriba y
           abajo, y estrellas a los costados. El degradado dorado se define
           una sola vez y lo usan todas las piezas.
        -->
        <div class="marco-oro" aria-hidden="true">
            <svg width="0" height="0" class="defs-oro">
                <defs>
                    <linearGradient id="po-oro" x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0" stop-color="#fff3cf"></stop>
                        <stop offset="0.45" stop-color="#e6bd68"></stop>
                        <stop offset="1" stop-color="#9c6a28"></stop>
                    </linearGradient>
                    <radialGradient id="po-gema" cx="0.35" cy="0.3" r="0.8">
                        <stop offset="0" stop-color="#f3c6ff"></stop>
                        <stop offset="0.45" stop-color="#a23ee0"></stop>
                        <stop offset="1" stop-color="#4a0e78"></stop>
                    </radialGradient>
                    <!-- Esquina: escuadra con rulos, hojitas y una gema -->
                    <symbol id="po-esquina" viewBox="0 0 120 120">
                        <g
                            fill="none"
                            stroke="url(#po-oro)"
                            stroke-width="2.4"
                            stroke-linecap="round"
                        >
                            <path d="M6 78 V20 Q6 6 20 6 H78"></path>
                            <path d="M16 60 Q16 16 60 16"></path>
                            <path
                                d="M78 6 q10 0 13 7 q3 8 -5 10 q-7 1 -7 -5 q0 -4 4 -4"
                            ></path>
                            <path
                                d="M6 78 q0 10 7 13 q8 3 10 -5 q1 -7 -5 -7 q-4 0 -4 4"
                            ></path>
                            <path
                                d="M28 28 q14 -4 19 7 q4 9 -5 11 q-7 1 -7 -5"
                            ></path>
                            <path
                                d="M28 28 q-4 14 7 19 q9 4 11 -5 q1 -7 -5 -7"
                            ></path>
                            <path d="M60 16 q12 2 18 10"></path>
                            <path d="M16 60 q2 12 10 18"></path>
                        </g>
                        <g fill="url(#po-oro)">
                            <path d="M44 9 q6 -6 12 0 q-6 5 -12 0z"></path>
                            <path d="M9 44 q-6 6 0 12 q5 -6 0 -12z"></path>
                            <circle cx="91" cy="11" r="2"></circle>
                            <circle cx="11" cy="91" r="2"></circle>
                        </g>
                        <circle
                            class="gema"
                            cx="20"
                            cy="20"
                            r="6.5"
                            fill="url(#po-gema)"
                            stroke="url(#po-oro)"
                            stroke-width="2"></circle>
                    </symbol>
                    <!-- Adorno del centro: rulos a los dos lados y una gema -->
                    <symbol id="po-centro" viewBox="0 0 200 50">
                        <g
                            fill="none"
                            stroke="url(#po-oro)"
                            stroke-width="2.2"
                            stroke-linecap="round"
                        >
                            <path
                                d="M100 25 q-18 -16 -40 -6 q-14 7 -26 0 q-8 -5 -4 -11 q4 -5 9 -1"
                            ></path>
                            <path
                                d="M100 25 q18 -16 40 -6 q14 7 26 0 q8 -5 4 -11 q-4 -5 -9 -1"
                            ></path>
                            <path d="M100 25 q-14 12 -34 8"></path>
                            <path d="M100 25 q14 12 34 8"></path>
                        </g>
                        <path
                            fill="url(#po-oro)"
                            d="M100 4 l5 9 l-5 4 l-5 -4z"></path>
                        <ellipse
                            class="gema"
                            cx="100"
                            cy="27"
                            rx="8"
                            ry="10"
                            fill="url(#po-gema)"
                            stroke="url(#po-oro)"
                            stroke-width="2.2"></ellipse>
                    </symbol>
                </defs>
            </svg>

            <svg class="esquina e-si"><use href="#po-esquina"></use></svg>
            <svg class="esquina e-sd"><use href="#po-esquina"></use></svg>
            <svg class="esquina e-ii"><use href="#po-esquina"></use></svg>
            <svg class="esquina e-id"><use href="#po-esquina"></use></svg>

            <svg class="centro-oro c-arriba"><use href="#po-centro"></use></svg>
            <svg class="centro-oro c-abajo"><use href="#po-centro"></use></svg>

            <span class="estrella-lado l-izq"></span>
            <span class="estrella-lado l-der"></span>
        </div>

        <!-- Rayos de luz girando muy lento -->
        <div class="rayos" aria-hidden="true"></div>

        <!-- Destellos de cuatro puntas que titilan -->
        <div class="destellos" aria-hidden="true">
            {
                destellos.map((d) => (
                    <span
                        class:list={["destello", { oro: d.oro }]}
                        style={`left:${d.izq}%; top:${d.arriba}%; width:${d.tam}px; height:${d.tam}px; animation-duration:${d.dur}s; animation-delay:-${d.retraso}s;`}
                    />
                ))
            }
        </div>

        <!-- Chispas que suben -->
        <div class="chispas" aria-hidden="true">
            {
                chispas.map((c) => (
                    <span
                        class:list={["chispa", { oro: c.oro }]}
                        style={`left:${c.izq}%; width:${c.tam}px; height:${c.tam}px; --deriva:${c.deriva}px; animation-duration:${c.dur}s; animation-delay:-${c.retraso}s;`}
                    />
                ))
            }
        </div>

        <!-- Contenido: nombre, sobre y llamada -->
        <div class="contenido">
            <div class="nombre-caja" id="nombre-caja">
                <img
                    src="/imagenes/nombre.webp"
                    alt={nombreAlt}
                    width="800"
                    height="363"
                    class="nombre"
                    fetchpriority="high"
                />
                <!-- Destello que recorre el nombre: usa el propio
                     dibujo como máscara, la luz solo cae sobre las letras -->
                <span class="brillo" aria-hidden="true"></span>
            </div>

            <button
                id="btn-sobre"
                type="button"
                aria-label="Abrir la invitación"
                class="sobre-boton"
            >
                <span class="sobre-flota" id="sobre-flota">
                    <img
                        src="/imagenes/sobre.webp"
                        alt=""
                        width="760"
                        height="547"
                        class="sobre"
                        aria-hidden="true"
                        fetchpriority="high"
                    />
                    <!-- Resplandor del lacre, justo sobre el 15 -->
                    <span class="lacre-luz" id="lacre-luz"></span>
                </span>
            </button>

            <p id="llamada-portada" class="llamada"><span>{llamada}</span></p>
        </div>

        <!-- Resplandor final al abrir -->
        <div class="resplandor" id="resplandor" aria-hidden="true"></div>
    </div>
</section>

<style>
    body.portada-activa {
        overflow: hidden !important;
        height: 100vh !important;
    }

    #capa-blanca {
        transition: opacity 0.4s ease;
    }

    /*
       Afuera de la columna (PC / tablet) va el mismo violeta oscuro del
       fondo. Declarado como degradado y no como color: el modo oscuro
       forzado oscurece colores pero respeta las imágenes.
    */
    #portada-section {
        height: 100vh;
        height: 100dvh;
        background-image: radial-gradient(
            ellipse at 50% 45%,
            #2a0b3d 0%,
            #12041c 60%,
            #07020c 100%
        );
    }

    /* ── Marco / fondo ──────────────────────────────────────── */
    /*
       El marco se ESTIRA al tamaño exacto de la pantalla (100% 100%): en
       un celular largo se alarga y en uno ancho se ensancha, siempre con
       las cuatro esquinas a la vista. El contenido se mide en dvh para
       quedar siempre adentro del marco, sin pisar los adornos.
    */
    .marco {
        position: relative;
        width: 100%;
        max-width: 480px;
        height: 100%;
        overflow: hidden;
        background-color: #07020c;
        /*
           El fondo es una escena (castillo entre árboles): cubre toda la
           pantalla sin deformarse. En un celular largo recorta un poco
           los costados, nunca el castillo.
        */
        background-image: url("/imagenes/fondoportada.webp");
        background-size: cover;
        background-position: center 40%;
        background-repeat: no-repeat;
        box-shadow: 0 0 60px rgba(150, 60, 220, 0.25);
        isolation: isolate;
    }

    /* ── Aura detrás del sobre ──────────────────────────────── */
    .aura {
        position: absolute;
        left: 50%;
        top: 55%;
        width: 120%;
        aspect-ratio: 1;
        transform: translate(-50%, -50%);
        background-image: radial-gradient(
            circle,
            rgba(196, 92, 255, 0.42) 0%,
            rgba(140, 40, 210, 0.22) 30%,
            rgba(90, 20, 150, 0) 62%
        );
        animation: latir 4.5s ease-in-out infinite;
        pointer-events: none;
        z-index: 1;
    }

    @keyframes latir {
        0%,
        100% {
            opacity: 0.75;
            transform: translate(-50%, -50%) scale(0.95);
        }
        50% {
            opacity: 1;
            transform: translate(-50%, -50%) scale(1.06);
        }
    }

    /* ── Rayos ──────────────────────────────────────────────── */
    .rayos {
        position: absolute;
        left: 50%;
        top: 55%;
        width: 150%;
        aspect-ratio: 1;
        margin-left: -75%;
        margin-top: -75%;
        background-image: repeating-conic-gradient(
            from 0deg,
            rgba(255, 210, 140, 0.11) 0deg 4deg,
            rgba(255, 210, 140, 0) 4deg 22deg
        );
        -webkit-mask-image: radial-gradient(
            circle,
            #000 0%,
            rgba(0, 0, 0, 0.5) 25%,
            transparent 55%
        );
        mask-image: radial-gradient(
            circle,
            #000 0%,
            rgba(0, 0, 0, 0.5) 25%,
            transparent 55%
        );
        animation: girar 60s linear infinite;
        mix-blend-mode: screen;
        pointer-events: none;
        z-index: 1;
    }

    @keyframes girar {
        to {
            transform: rotate(360deg);
        }
    }

    /* ── Destellos de cuatro puntas ─────────────────────────── */
    .destellos,
    .chispas {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 2;
    }

    .destello {
        position: absolute;
        transform: translate(-50%, -50%) scale(0);
        animation-name: titilar;
        animation-timing-function: ease-in-out;
        animation-iteration-count: infinite;
        --c: 230, 170, 255;
    }

    .destello.oro {
        --c: 255, 222, 150;
    }

    .destello::before,
    .destello::after {
        content: "";
        position: absolute;
        left: 50%;
        top: 50%;
        border-radius: 50%;
        transform: translate(-50%, -50%);
        background-image: radial-gradient(
            ellipse,
            rgba(255, 255, 255, 1) 0%,
            rgba(var(--c), 0.9) 35%,
            rgba(var(--c), 0) 70%
        );
    }

    .destello::before {
        width: 100%;
        height: 18%;
    }

    .destello::after {
        width: 18%;
        height: 100%;
    }

    @keyframes titilar {
        0%,
        100% {
            transform: translate(-50%, -50%) scale(0);
            opacity: 0;
        }
        50% {
            transform: translate(-50%, -50%) scale(1.5);
            opacity: 1;
        }
    }

    /* ── Chispas que suben ──────────────────────────────────── */
    .chispa {
        position: absolute;
        bottom: 10%;
        border-radius: 50%;
        background-image: radial-gradient(
            circle,
            rgba(240, 190, 255, 1) 0%,
            rgba(190, 90, 255, 0) 70%
        );
        box-shadow: 0 0 6px rgba(200, 110, 255, 0.8);
        animation-name: subir;
        animation-timing-function: linear;
        animation-iteration-count: infinite;
        opacity: 0;
    }

    .chispa.oro {
        background-image: radial-gradient(
            circle,
            rgba(255, 236, 180, 1) 0%,
            rgba(240, 180, 80, 0) 70%
        );
        box-shadow: 0 0 6px rgba(255, 200, 110, 0.8);
    }

    @keyframes subir {
        0% {
            transform: translate(0, 0);
            opacity: 0;
        }
        12% {
            opacity: 0.9;
        }
        75% {
            opacity: 0.45;
        }
        100% {
            transform: translate(var(--deriva), -78dvh);
            opacity: 0;
        }
    }

    /* ── Contenido ──────────────────────────────────────────── */
    /*
       Los rellenos de arriba y abajo dejan libres el adorno de la gema
       (arriba) y la rosa (abajo) del marco. Van en dvh porque el marco
       se estira con el alto: así el contenido acompaña al marco en
       cualquier celular.
    */
    .contenido {
        position: relative;
        z-index: 3;
        height: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-evenly;
        padding: 15dvh 9% 14dvh;
        box-sizing: border-box;
    }

    .nombre-caja {
        position: relative;
        width: min(84%, 42dvh);
        flex: 0 0 auto;
    }

    .nombre {
        display: block;
        width: 100%;
        height: auto;
        user-select: none;
        -webkit-user-drag: none;
        filter: drop-shadow(0 4px 14px rgba(0, 0, 0, 0.6))
            drop-shadow(0 0 18px rgba(200, 100, 255, 0.35));
    }

    .brillo {
        position: absolute;
        inset: 0;
        pointer-events: none;
        mix-blend-mode: screen;
        -webkit-mask-image: url("/imagenes/nombre.webp");
        mask-image: url("/imagenes/nombre.webp");
        -webkit-mask-size: 100% 100%;
        mask-size: 100% 100%;
        -webkit-mask-repeat: no-repeat;
        mask-repeat: no-repeat;
        background-image: linear-gradient(
            100deg,
            rgba(255, 255, 255, 0) 42%,
            rgba(255, 246, 220, 0.9) 50%,
            rgba(255, 255, 255, 0) 58%
        );
        background-size: 260% 100%;
        background-repeat: no-repeat;
        background-position: 150% 0;
        animation: pasarLuz 5s ease-in-out infinite;
        animation-delay: 2.6s;
    }

    @keyframes pasarLuz {
        0% {
            background-position: 150% 0;
        }
        45%,
        100% {
            background-position: -150% 0;
        }
    }

    /* ── Sobre ──────────────────────────────────────────────── */
    .sobre-boton {
        display: block;
        flex: 0 0 auto;
        width: min(90%, 46dvh);
        padding: 0;
        border: 0;
        background: transparent;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
    }

    .sobre-boton:focus-visible {
        outline: 2px solid rgba(255, 215, 140, 0.8);
        outline-offset: 6px;
        border-radius: 8px;
    }

    .sobre-flota {
        position: relative;
        display: block;
    }

    .sobre {
        display: block;
        width: 100%;
        height: auto;
        user-select: none;
        -webkit-user-drag: none;
        filter: drop-shadow(0 16px 26px rgba(0, 0, 0, 0.55))
            drop-shadow(0 0 22px rgba(190, 80, 255, 0.45));
    }

    /* Luz sobre el lacre: queda centrada en el 15 */
    .lacre-luz {
        position: absolute;
        left: 50%;
        top: 49.5%;
        width: 34%;
        aspect-ratio: 1;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        background-image: radial-gradient(
            circle,
            rgba(255, 230, 170, 0.55) 0%,
            rgba(220, 120, 255, 0.3) 40%,
            rgba(220, 120, 255, 0) 70%
        );
        mix-blend-mode: screen;
        pointer-events: none;
        animation: lacre 3s ease-in-out infinite;
    }

    @keyframes lacre {
        0%,
        100% {
            opacity: 0.35;
            transform: translate(-50%, -50%) scale(0.9);
        }
        50% {
            opacity: 0.9;
            transform: translate(-50%, -50%) scale(1.1);
        }
    }

    /* ── Llamada ────────────────────────────────────────────── */
    .llamada {
        flex: 0 0 auto;
        margin: 0;
        font-family: "Cormorant Garamond", serif;
        font-weight: 600;
        font-size: clamp(1.5rem, min(8vw, 4.2dvh), 2.2rem);
        letter-spacing: 0.02em;
        line-height: 1.1;
        text-align: center;
        background-image: linear-gradient(
            180deg,
            #fff4d6 0%,
            #f2cf82 50%,
            #c8954a 100%
        );
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.8))
            drop-shadow(0 0 10px rgba(210, 120, 255, 0.45));
    }

    .llamada span {
        display: inline-block;
        animation: invitar 2.4s ease-in-out infinite;
    }

    @keyframes invitar {
        0%,
        100% {
            opacity: 0.7;
        }
        50% {
            opacity: 1;
        }
    }

    /* ── Resplandor de apertura ─────────────────────────────── */
    .resplandor {
        position: absolute;
        inset: 0;
        z-index: 5;
        opacity: 0;
        pointer-events: none;
        background-image: radial-gradient(
            circle at 50% 52%,
            #fff8ec 0%,
            #f3d9ff 35%,
            rgba(190, 90, 255, 0.6) 65%,
            rgba(90, 20, 150, 0) 100%
        );
    }

    /* Chispas del estallido: las crea el script al tocar */
    :global(.estallido) {
        position: absolute;
        z-index: 4;
        border-radius: 50%;
        pointer-events: none;
    }

    /* Quien pidió menos movimiento, recibe menos movimiento */
    /* ── Marco dorado de fantasía ────────────────────────────── */
    /*
       Doble filete dorado a 10px del borde, con las piezas de adorno
       encima. Va por encima del contenido pero no se puede tocar, así
       nunca le quita el toque al sobre.
    */
    .marco-oro {
        position: absolute;
        inset: 10px;
        z-index: 4;
        pointer-events: none;
        border: 1.5px solid rgba(230, 189, 104, 0.85);
        border-radius: 6px;
        box-shadow:
            0 0 10px rgba(255, 200, 110, 0.25),
            inset 0 0 14px rgba(255, 200, 110, 0.15);
        animation: aparecerMarco 1.4s ease-out both;
    }

    /* El segundo filete, más fino, por dentro */
    .marco-oro::before {
        content: "";
        position: absolute;
        inset: 6px;
        border: 1px solid rgba(230, 189, 104, 0.45);
        border-radius: 4px;
    }

    .defs-oro {
        position: absolute;
    }

    @keyframes aparecerMarco {
        from {
            opacity: 0;
            transform: scale(1.03);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    /* Las cuatro esquinas: la misma pieza, espejada */
    .esquina {
        position: absolute;
        width: min(27vw, 120px);
        height: min(27vw, 120px);
        overflow: visible;
        filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.6))
            drop-shadow(0 0 6px rgba(255, 200, 110, 0.35));
    }

    .e-si {
        top: -5px;
        left: -5px;
    }

    .e-sd {
        top: -5px;
        right: -5px;
        transform: scaleX(-1);
    }

    .e-ii {
        bottom: -5px;
        left: -5px;
        transform: scaleY(-1);
    }

    .e-id {
        bottom: -5px;
        right: -5px;
        transform: scale(-1, -1);
    }

    /* Adorno con gema, centrado arriba y abajo, montado sobre el filete */
    .centro-oro {
        position: absolute;
        left: 0;
        right: 0;
        margin: 0 auto;
        width: min(46vw, 210px);
        height: min(11.5vw, 52px);
        overflow: visible;
        filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.6))
            drop-shadow(0 0 6px rgba(255, 200, 110, 0.35));
    }

    .c-arriba {
        top: -4px;
    }

    .c-abajo {
        bottom: -4px;
        transform: scaleY(-1);
    }

    /* Las gemas laten con un brillo violeta */
    .marco-oro :global(.gema) {
        animation: gemaLatir 3s ease-in-out infinite;
    }

    @keyframes gemaLatir {
        0%,
        100% {
            filter: drop-shadow(0 0 1px rgba(220, 140, 255, 0.4));
        }
        50% {
            filter: drop-shadow(0 0 6px rgba(230, 150, 255, 1));
        }
    }

    /* Estrellas doradas de cuatro puntas, a media altura de los lados */
    .estrella-lado {
        position: absolute;
        top: 50%;
        width: 22px;
        height: 22px;
        margin-top: -11px;
        animation: estrellaLado 3.4s ease-in-out infinite;
    }

    .l-izq {
        left: -11px;
    }

    .l-der {
        right: -11px;
        animation-delay: -1.7s;
    }

    .estrella-lado::before,
    .estrella-lado::after {
        content: "";
        position: absolute;
        left: 50%;
        top: 50%;
        border-radius: 50%;
        transform: translate(-50%, -50%);
        background-image: radial-gradient(
            ellipse,
            #fff 0%,
            #f3cf7e 35%,
            rgba(230, 180, 90, 0) 72%
        );
    }

    .estrella-lado::before {
        width: 100%;
        height: 22%;
    }

    .estrella-lado::after {
        width: 22%;
        height: 100%;
    }

    @keyframes estrellaLado {
        0%,
        100% {
            transform: scale(0.75);
            opacity: 0.7;
        }
        50% {
            transform: scale(1.15);
            opacity: 1;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .marco-oro,
        .marco-oro :global(.gema),
        .estrella-lado {
            animation: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .aura,
        .rayos,
        .destello,
        .chispa,
        .brillo,
        .lacre-luz,
        .llamada span {
            animation: none;
        }
        .chispa {
            display: none;
        }
        .destello {
            transform: translate(-50%, -50%) scale(1);
            opacity: 0.6;
        }
    }
</style>

<script>
    import { gsap } from "gsap";

    if (typeof window !== "undefined") {
        document.addEventListener("DOMContentLoaded", () => {
            document.body.classList.add("portada-activa");

            const boton = document.getElementById("btn-sobre");
            const flota = document.getElementById("sobre-flota");
            const nombre = document.getElementById("nombre-caja");
            const llamada = document.getElementById("llamada-portada");
            const lacreLuz = document.getElementById("lacre-luz");
            const aura = document.getElementById("aura");
            const marco = document.getElementById("marco-portada");
            const resplandor = document.getElementById("resplandor");
            const seccion = document.getElementById("portada-section");
            const capaBlanca = document.getElementById("capa-blanca");
            if (!boton || !flota || !marco) return;

            const menosMovimiento = window.matchMedia(
                "(prefers-reduced-motion: reduce)",
            ).matches;

            let abriendo = false;

            // ── Estado inicial ──────────────────────────────────────
            gsap.set(nombre, { opacity: 0, y: -24, scale: 0.92 });
            gsap.set(flota, { opacity: 0, y: 40, scale: 0.85 });
            gsap.set(llamada, { opacity: 0, y: 12 });

            // ── Entrada ─────────────────────────────────────────────
            const tl = gsap.timeline({ delay: 0.3 });
            tl.to(nombre, {
                opacity: 1,
                y: 0,
                scale: 1,
                duration: 1.2,
                ease: "power3.out",
            })
                .to(
                    flota,
                    {
                        opacity: 1,
                        y: 0,
                        scale: 1,
                        duration: 1.2,
                        ease: "back.out(1.4)",
                    },
                    0.45,
                )
                .to(
                    llamada,
                    {
                        opacity: 1,
                        y: 0,
                        duration: 0.8,
                        ease: "power2.out",
                    },
                    1.2,
                );

            // ── El sobre flota apenas ───────────────────────────────
            if (!menosMovimiento) {
                tl.add(() => {
                    if (abriendo) return;
                    gsap.to(flota, {
                        y: -8,
                        rotate: 0.6,
                        duration: 2.6,
                        repeat: -1,
                        yoyo: true,
                        ease: "sine.inOut",
                    });
                });
            }

            // ── Suelta el scroll y deja la invitación arrancada en el
            //    sobre de NombresFlores, su primera sección.
            const abrirInvitacion = () => {
                document.body.classList.remove("portada-activa");
                document.body.style.overflow = "auto";

                const destino = document.getElementById("sobre-novios");
                if (destino) {
                    destino.scrollIntoView({ block: "start" });
                } else {
                    window.scrollTo({ top: 0 });
                }

                // Aviso para que las secciones recién ahora arranquen
                // su entrada (si no, se dispararían tapadas por la portada)
                (window as any).portadaAbierta = true;
                window.dispatchEvent(new Event("portada-abierta"));
            };

            /*
               Lluvia de chispas que sale del lacre. Se crean acá y no en
               el servidor porque viven medio segundo y solo al tocar.
            */
            const estallar = () => {
                if (menosMovimiento) return;
                const caja = marco.getBoundingClientRect();
                const s = flota.getBoundingClientRect();
                const cx = s.left + s.width / 2 - caja.left;
                const cy = s.top + s.height * 0.495 - caja.top;
                const colores = [
                    "255,230,170",
                    "230,160,255",
                    "255,255,255",
                    "200,110,255",
                ];
                for (let i = 0; i < 34; i++) {
                    const p = document.createElement("span");
                    const tam = 3 + Math.random() * 5;
                    const c = colores[i % colores.length];
                    p.className = "estallido";
                    p.style.cssText = `left:${cx}px;top:${cy}px;width:${tam}px;height:${tam}px;margin:-${tam / 2}px 0 0 -${tam / 2}px;background:radial-gradient(circle,rgba(${c},1) 0%,rgba(${c},0) 70%);box-shadow:0 0 8px rgba(${c},.9);`;
                    marco.appendChild(p);
                    const ang = (Math.PI * 2 * i) / 34 + Math.random() * 0.3;
                    const dist = 80 + Math.random() * 150;
                    gsap.to(p, {
                        x: Math.cos(ang) * dist,
                        y: Math.sin(ang) * dist,
                        opacity: 0,
                        scale: 0.3,
                        duration: 0.9 + Math.random() * 0.6,
                        ease: "power3.out",
                        onComplete: () => p.remove(),
                    });
                }
            };

            // ── Abrir la invitación ─────────────────────────────────
            const abrirTodo = () => {
                if (abriendo) return;
                abriendo = true;

                gsap.killTweensOf(flota);

                /*
                   Acá arranca la música, y tiene que ser acá: los
                   navegadores solo dejan sonar un audio si lo pide un
                   gesto de la persona. Queda en window.audioGlobal para
                   que el botón de la esquina maneje esta misma melodía.
                */
                const yaExiste = (window as any).audioGlobal as
                    | HTMLAudioElement
                    | undefined;
                const melodia = yaExiste ?? new Audio("/musica/melodia2.mp3");
                melodia.loop = true;
                melodia.volume = 0.65;
                (window as any).audioGlobal = melodia;
                melodia.play().catch(() => {});

                gsap.timeline()
                    // El sobre se hunde como si lo apretaran
                    .to(flota, {
                        scale: 0.94,
                        rotate: 0,
                        y: 0,
                        duration: 0.16,
                        ease: "power2.in",
                    })
                    // ...y tiembla
                    .to(flota, {
                        x: 5,
                        rotate: 1.5,
                        duration: 0.06,
                        repeat: 5,
                        yoyo: true,
                        ease: "sine.inOut",
                    })
                    .set(flota, { x: 0, rotate: 0 })
                    // Las animaciones de CSS le ganan a GSAP: se apagan
                    .set([lacreLuz, aura], { animation: "none" }, 0)
                    // El lacre se enciende y estallan las chispas
                    .to(
                        lacreLuz,
                        {
                            opacity: 1,
                            scale: 2.4,
                            duration: 0.45,
                            ease: "power2.out",
                        },
                        0.2,
                    )
                    .add(estallar, 0.45)
                    .to(
                        aura,
                        {
                            scale: 1.6,
                            opacity: 1,
                            duration: 1,
                            ease: "power2.out",
                        },
                        0.4,
                    )
                    .to(
                        llamada,
                        { opacity: 0, y: 10, duration: 0.35 },
                        0,
                    )
                    .to(
                        nombre,
                        { opacity: 0, y: -20, duration: 0.6, ease: "power2.in" },
                        0.5,
                    )
                    // El sobre crece hacia la cámara
                    .to(
                        flota,
                        {
                            scale: 1.5,
                            opacity: 0,
                            duration: 0.9,
                            ease: "power2.in",
                        },
                        0.55,
                    )
                    // Resplandor que llena la pantalla
                    .to(
                        resplandor,
                        { opacity: 1, duration: 0.6, ease: "power2.in" },
                        0.85,
                    )
                    .to(
                        seccion,
                        {
                            opacity: 0,
                            duration: 0.6,
                            ease: "power2.inOut",
                            onStart: abrirInvitacion,
                            onComplete: () => {
                                seccion?.remove();
                                gsap.to(capaBlanca, {
                                    opacity: 0,
                                    duration: 0.4,
                                    ease: "power2.out",
                                    onComplete: () => capaBlanca?.remove(),
                                });
                            },
                        },
                        1.45,
                    );
            };

            boton.addEventListener("click", abrirTodo);

            /*
               En PC el sobre acompaña un poco al mouse; en celular, la
               inclinación del aparato. Pocos grados: alcanza para que
               parezca que flota delante del fondo.
            */
            if (!menosMovimiento && seccion) {
                const mover = (gx: number, gy: number) => {
                    if (abriendo) return;
                    gsap.to(boton, {
                        x: gx,
                        y: gy,
                        duration: 0.8,
                        ease: "power2.out",
                        overwrite: "auto",
                    });
                };
                seccion.addEventListener("mousemove", (e) => {
                    const mx = e.clientX / window.innerWidth - 0.5;
                    const my = e.clientY / window.innerHeight - 0.5;
                    mover(mx * 14, my * 10);
                });
                seccion.addEventListener("mouseleave", () => mover(0, 0));
                window.addEventListener("deviceorientation", (e) => {
                    if (e.gamma === null || e.beta === null) return;
                    const gx = Math.max(-8, Math.min(8, e.gamma / 4));
                    const gy = Math.max(-6, Math.min(6, (e.beta - 45) / 6));
                    mover(gx, gy);
                });
            }
        });
    }
</script>
