---
// src/components/Dedicatoria.astro
// Dedicatoria de los XV: el marco dorado con flores y castillo
// (/imagenes/dedicatoria.webp) y el texto encima, en la parte libre del
// centro. Va justo debajo del video de NombresFlores.
//
// La imagen se muestra entera, con su proporción (9:16): el texto se mide
// en cqw (% del ancho de la sección) para quedar siempre en el mismo
// lugar del marco, en cualquier celular.
// ── DATOS EDITABLES ───────────────────────────────────────────
const parrafo1 =
    "Dicen que cuando despertamos tenemos diez segundos para recordar lo que soñamos...";
const parrafo2 = "Hoy es una realidad";
const titulo1 = "Mi Fiesta de";
const titulo2 = "15 años";
const parrafo3 =
    "Tú presencia ayudará a transformar mi noche inolvidable, en el día más importante de mi vida...";
// ──────────────────────────────────────────────────────────────

/*
   Destellos de la niebla que une el video con el marco. Calculados acá
   para que servidor y navegador dibujen exactamente lo mismo.
*/
const destellosUnion = Array.from({ length: 8 }, (_, i) => ({
    izq: 6 + ((i * 41) % 88),
    arriba: 22 + ((i * 29) % 56),
    tam: 7 + (i % 3) * 4,
    dur: 2.4 + (i % 4) * 0.7,
    retraso: (i * 0.7) % 3.5,
}));
---

<section id="dedicatoria" class="seccion">
    <!--
       Unión con el video: una niebla morada neón con destellos montada
       sobre el borde, para que castillo y marco se lean como una sola
       escena.
    -->
    <div class="union" aria-hidden="true">
        <span class="bruma b1"></span>
        <span class="bruma b2"></span>
        <span class="bruma b3"></span>
        {
            destellosUnion.map((d) => (
                <span
                    class="destello"
                    style={`left:${d.izq}%; top:${d.arriba}%; width:${d.tam}px; height:${d.tam}px; animation-duration:${d.dur}s; animation-delay:-${d.retraso}s;`}
                />
            ))
        }
    </div>

    <img
        src="/imagenes/dedicatoria.webp"
        alt=""
        aria-hidden="true"
        width="900"
        height="1599"
        class="fondo"
        loading="lazy"
    />

    <div class="texto" id="ded-texto">
        <p class="parrafo">{parrafo1}</p>
        <p class="parrafo">{parrafo2}</p>
        <h2 class="titulo">
            <span>{titulo1}</span>
            <span>{titulo2}</span>
        </h2>
        <p class="parrafo">{parrafo3}</p>
    </div>
</section>

<style>
    /*
       container-type deja medir el texto contra el ancho de la sección y
       no del viewport. El fondo va como degradado y no como color: el
       modo oscuro forzado oscurece colores pero respeta las imágenes.
    */
    /*
       La sección sube un 9% del ancho y se monta sobre la base negra del
       castillo del video. Va sin fondo propio: en esa franja se ve el
       video por detrás mientras el marco aparece de a poco (ver .fondo).
    */
    .seccion {
        position: relative;
        z-index: 1;
        width: 100%;
        margin-top: -9%;
        container-type: inline-size;
        /*
           Transparente solo en la franja montada sobre el video (9% del
           ancho = 5% del alto); de ahí para abajo, el mismo negro con que
           termina el video, para que la parte suave del marco no deje
           ver el fondo de la página.
        */
        background-image: linear-gradient(
            180deg,
            transparent 0%,
            transparent 5%,
            #08020c 5%
        );
    }

    /*
       El marco sale de la oscuridad: la máscara lo deja transparente en
       el borde de arriba y lo va mostrando hasta el 6% del alto. Así la
       línea dorada y la punta del corazón no arrancan de golpe.
    */
    .fondo {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 900 / 1599;
        user-select: none;
        -webkit-user-drag: none;
        -webkit-mask-image: linear-gradient(
            180deg,
            transparent 0%,
            rgba(0, 0, 0, 0.55) 3%,
            #000 6.5%
        );
        mask-image: linear-gradient(
            180deg,
            transparent 0%,
            rgba(0, 0, 0, 0.55) 3%,
            #000 6.5%
        );
    }

    /* ── Unión con el video ─────────────────────────────────── */
    .union {
        position: absolute;
        left: 0;
        right: 0;
        top: -20cqw;
        height: 42cqw;
        z-index: 2;
        pointer-events: none;
        overflow: hidden;
        /* Bordes de arriba y abajo difuminados: la niebla nunca se corta */
        -webkit-mask-image: linear-gradient(
            180deg,
            transparent 0%,
            #000 30%,
            #000 68%,
            transparent 100%
        );
        mask-image: linear-gradient(
            180deg,
            transparent 0%,
            #000 30%,
            #000 68%,
            transparent 100%
        );
    }

    /*
       Niebla: tres capas el doble de anchas que la pantalla, hechas de
       jirones (elipses muy aplastadas). Cada una va y viene de izquierda
       a derecha a su propio ritmo; al cruzarse parece niebla que se mueve.
       Van en morado neón para que brillen sobre el negro.
    */
    .bruma {
        position: absolute;
        left: -50%;
        width: 200%;
        top: 0;
        height: 100%;
        filter: blur(6px);
        mix-blend-mode: screen;
        animation: niebla ease-in-out infinite alternate;
    }

    .b1 {
        background-image:
            radial-gradient(ellipse 22% 16% at 18% 52%, rgba(190, 60, 255, 0.6), transparent 70%),
            radial-gradient(ellipse 18% 12% at 46% 44%, rgba(225, 90, 255, 0.5), transparent 70%),
            radial-gradient(ellipse 24% 14% at 74% 56%, rgba(170, 50, 255, 0.55), transparent 70%);
        animation-duration: 14s;
    }

    .b2 {
        background-image:
            radial-gradient(ellipse 20% 13% at 30% 60%, rgba(150, 40, 255, 0.55), transparent 70%),
            radial-gradient(ellipse 26% 15% at 62% 48%, rgba(210, 80, 255, 0.5), transparent 70%),
            radial-gradient(ellipse 16% 11% at 90% 58%, rgba(150, 40, 255, 0.5), transparent 70%);
        animation-duration: 19s;
        animation-direction: alternate-reverse;
    }

    .b3 {
        background-image:
            radial-gradient(ellipse 30% 10% at 25% 50%, rgba(235, 140, 255, 0.35), transparent 70%),
            radial-gradient(ellipse 30% 10% at 70% 52%, rgba(235, 140, 255, 0.32), transparent 70%);
        animation-duration: 24s;
        animation-delay: -8s;
    }

    @keyframes niebla {
        from {
            transform: translateX(-12%);
        }
        to {
            transform: translateX(12%);
        }
    }

    /* Destellos de cuatro puntas, como los de la portada */
    .destello {
        position: absolute;
        transform: translate(-50%, -50%) scale(0);
        animation: titilar ease-in-out infinite;
    }

    .destello::before,
    .destello::after {
        content: "";
        position: absolute;
        left: 50%;
        top: 50%;
        border-radius: 50%;
        transform: translate(-50%, -50%);
        background-image: radial-gradient(
            ellipse,
            #fff 0%,
            rgba(255, 222, 150, 0.9) 35%,
            rgba(255, 222, 150, 0) 70%
        );
    }

    .destello::before {
        width: 100%;
        height: 18%;
    }

    .destello::after {
        width: 18%;
        height: 100%;
    }

    @keyframes titilar {
        0%,
        100% {
            transform: translate(-50%, -50%) scale(0);
            opacity: 0;
        }
        50% {
            transform: translate(-50%, -50%) scale(1.5);
            opacity: 1;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .bruma,
        .destello {
            animation: none;
        }
        .destello {
            transform: translate(-50%, -50%) scale(1);
            opacity: 0.7;
        }
    }

    /*
       La zona libre del marco va más o menos del 18% al 66% del alto:
       arriba queda el corazón y abajo el castillo. El texto se centra
       ahí, con los costados lejos de las enredaderas.
    */
    .texto {
        position: absolute;
        left: 23%;
        right: 23%;
        top: 19%;
        bottom: 36%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 5cqw;
        text-align: center;
        color: #fbf4ff;
    }

    .parrafo {
        margin: 0;
        font-family: "Cormorant Garamond", serif;
        font-weight: 500;
        font-size: 4.5cqw;
        line-height: 1.3;
        text-shadow:
            0 1px 4px rgba(0, 0, 0, 0.7),
            0 0 10px rgba(150, 60, 210, 0.45);
    }

    /* Great Vibes, sin mayúsculas forzadas ni espaciado entre letras */
    .titulo {
        margin: 1cqw 0;
        font-family: "Great Vibes", cursive;
        font-weight: 400;
        font-size: 11cqw;
        line-height: 1.05;
        color: #ffffff;
        text-shadow:
            0 0 6px rgba(255, 255, 255, 0.55),
            0 0 18px rgba(200, 110, 255, 0.8),
            0 2px 6px rgba(0, 0, 0, 0.6);
    }

    .titulo span {
        display: block;
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const texto = document.getElementById("ded-texto");
        if (
            !texto ||
            window.matchMedia("(prefers-reduced-motion: reduce)").matches
        )
            return;

        // Los renglones aparecen uno tras otro al llegar a la sección
        gsap.fromTo(
            Array.from(texto.children),
            { opacity: 0, y: 16 },
            {
                opacity: 1,
                y: 0,
                duration: 1,
                stagger: 0.25,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: texto,
                    start: "top 80%",
                    toggleActions: "play none none reset",
                },
            },
        );
    });
</script>
