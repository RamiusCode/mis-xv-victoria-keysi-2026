---
// src/components/NombresPadres.astro
// "Con la bendición de mis padres" y los nombres de los papás de la
// quinceañera, sobre el mismo cielo de estrellas del Calendario
// (/imagenes/fondocalendario.webp), con estrellitas subiendo y destellos.
// Va entre la Dedicatoria y el Calendario.
// ── DATOS EDITABLES ───────────────────────────────────────────
const introduccion = "Con la bendición de Dios y mis padres";
const padres = [
    "Miguel Ángel Vidal Torrico",
    "Magaly Fernanda Cardozo Aguilar",
];
const tituloPadrinos = "Mis padrinos";
const padrinos = ["Héctor Dueñas y Sra."];
// ──────────────────────────────────────────────────────────────

// Estrellitas y destellos: calculados acá para que servidor y navegador
// dibujen exactamente lo mismo.
const estrellas = Array.from({ length: 20 }, (_, i) => ({
    izq: (i * 41 + 3) % 100,
    tam: 2 + (i % 4) * 1.1,
    dur: 8 + ((i * 5) % 7),
    retraso: (i * 1.1) % 12,
    deriva: ((i * 13) % 30) - 15,
    oro: i % 3 === 1,
}));

const destellos = Array.from({ length: 6 }, (_, i) => ({
    izq: 8 + ((i * 47) % 84),
    arriba: 12 + ((i * 31) % 76),
    tam: 8 + (i % 3) * 4,
    dur: 2.6 + (i % 4) * 0.7,
    retraso: (i * 0.8) % 4,
}));
---

<section id="padres" class="seccion">
    <div class="estrellas" aria-hidden="true">
        {
            estrellas.map((e) => (
                <span
                    class:list={["estrella", { oro: e.oro }]}
                    style={`left:${e.izq}%; width:${e.tam}px; height:${e.tam}px; --deriva:${e.deriva}px; animation-duration:${e.dur}s; animation-delay:-${e.retraso}s;`}
                />
            ))
        }
        {
            destellos.map((d) => (
                <span
                    class="destello"
                    style={`left:${d.izq}%; top:${d.arriba}%; width:${d.tam}px; height:${d.tam}px; animation-duration:${d.dur}s; animation-delay:-${d.retraso}s;`}
                />
            ))
        }
    </div>

    <div class="contenido" id="np-contenido">
        <p class="introduccion">{introduccion}</p>
        <span class="adorno" aria-hidden="true"><i></i></span>
        {padres.map((p) => <p class="nombre">{p}</p>)}

        <p class="introduccion segundo">{tituloPadrinos}</p>
        <span class="adorno" aria-hidden="true"><i></i></span>
        {padrinos.map((p) => <p class="nombre">{p}</p>)}
    </div>
</section>

<style>
    /*
       Mismo cielo que el Calendario. Arriba y abajo se funde con el negro
       del marco de la Dedicatoria y del arranque del Calendario, así las
       tres secciones se ven seguidas. Va como degradado y no como color:
       el modo oscuro forzado oscurece colores pero respeta las imágenes.
    */
    .seccion {
        position: relative;
        width: 100%;
        overflow: hidden;
        container-type: inline-size;
        background-image:
            linear-gradient(
                180deg,
                #08020c 0%,
                rgba(8, 2, 12, 0) 22%,
                rgba(8, 2, 12, 0) 78%,
                #08020c 100%
            ),
            url("/imagenes/fondocalendario.webp");
        background-size: 100% 100%, cover;
        background-repeat: no-repeat;
        background-position: center, center;
        background-color: #12051f;
        text-align: center;
    }

    .contenido {
        position: relative;
        z-index: 1;
        padding: 14cqw 8% 14cqw;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    /* ── Estrellitas que suben + destellos ──────────────────── */
    .estrellas {
        position: absolute;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
        container-type: size;
    }

    .estrella {
        position: absolute;
        bottom: -2%;
        border-radius: 50%;
        background-image: radial-gradient(
            circle,
            #ffffff 0%,
            rgba(220, 170, 255, 0.9) 40%,
            rgba(190, 110, 255, 0) 72%
        );
        box-shadow: 0 0 6px rgba(210, 150, 255, 0.85);
        opacity: 0;
        animation: flotar linear infinite;
    }

    .estrella.oro {
        background-image: radial-gradient(
            circle,
            #ffffff 0%,
            rgba(255, 225, 160, 0.9) 40%,
            rgba(255, 200, 110, 0) 72%
        );
        box-shadow: 0 0 6px rgba(255, 215, 140, 0.85);
    }

    @keyframes flotar {
        0% {
            transform: translate(0, 0) scale(0.6);
            opacity: 0;
        }
        10% {
            opacity: 0.95;
        }
        50% {
            transform: translate(var(--deriva), -50cqh) scale(1);
        }
        85% {
            opacity: 0.6;
        }
        100% {
            transform: translate(calc(var(--deriva) * -0.5), -100cqh)
                scale(0.8);
            opacity: 0;
        }
    }

    .destello {
        position: absolute;
        transform: translate(-50%, -50%) scale(0);
        animation: titilar ease-in-out infinite;
    }

    .destello::before,
    .destello::after {
        content: "";
        position: absolute;
        left: 50%;
        top: 50%;
        border-radius: 50%;
        transform: translate(-50%, -50%);
        background-image: radial-gradient(
            ellipse,
            #fff 0%,
            rgba(255, 222, 150, 0.9) 35%,
            rgba(255, 222, 150, 0) 70%
        );
    }

    .destello::before {
        width: 100%;
        height: 18%;
    }

    .destello::after {
        width: 18%;
        height: 100%;
    }

    @keyframes titilar {
        0%,
        100% {
            transform: translate(-50%, -50%) scale(0);
            opacity: 0;
        }
        50% {
            transform: translate(-50%, -50%) scale(1.5);
            opacity: 1;
        }
    }

    /* ── Textos ─────────────────────────────────────────────── */
    /* Los títulos van en Great Vibes dorada. Sin mayúsculas forzadas ni
       espaciado entre letras. */
    .introduccion {
        margin: 0;
        font-family: "Great Vibes", cursive;
        font-weight: 400;
        font-size: 11cqw;
        line-height: 1.15;
        background-image: linear-gradient(
            180deg,
            #fff3cf 0%,
            #f1cb7a 50%,
            #b98a3e 100%
        );
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.6))
            drop-shadow(0 0 14px rgba(210, 120, 255, 0.5));
    }

    /* Aire entre los padres y el título de los padrinos */
    .introduccion.segundo {
        margin-top: 11cqw;
    }

    /* Filete dorado con un rombito al medio */
    .adorno {
        position: relative;
        display: block;
        width: 46%;
        height: 1px;
        margin: 4.5cqw auto 3cqw;
        background-image: linear-gradient(
            90deg,
            rgba(225, 181, 94, 0),
            rgba(225, 181, 94, 0.95),
            rgba(225, 181, 94, 0)
        );
    }

    .adorno i {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 1.8cqw;
        height: 1.8cqw;
        transform: translate(-50%, -50%) rotate(45deg);
        background-image: linear-gradient(135deg, #f3d58f, #b98a3e);
    }

    /* Los nombres en letra normal, blanca y clara */
    .nombre {
        margin: 1.5cqw 0 0;
        font-family: "Cormorant Garamond", serif;
        font-weight: 600;
        font-size: 7cqw;
        line-height: 1.3;
        color: #ffffff;
        text-shadow:
            0 1px 4px rgba(0, 0, 0, 0.7),
            0 0 10px rgba(150, 60, 210, 0.5);
    }

    @media (prefers-reduced-motion: reduce) {
        .estrella {
            display: none;
        }
        .destello {
            animation: none;
            transform: translate(-50%, -50%) scale(1);
            opacity: 0.7;
        }
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        const contenido = document.getElementById("np-contenido");
        if (
            !contenido ||
            window.matchMedia("(prefers-reduced-motion: reduce)").matches
        )
            return;

        // La frase, el filete y los dos nombres, uno tras otro
        gsap.fromTo(
            Array.from(contenido.children),
            { opacity: 0, y: 18 },
            {
                opacity: 1,
                y: 0,
                duration: 1,
                stagger: 0.22,
                ease: "power2.out",
                scrollTrigger: {
                    trigger: contenido,
                    start: "top 80%",
                    toggleActions: "play none none reset",
                },
            },
        );
    });
</script>
